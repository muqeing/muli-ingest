# Copy this file to .env and replace every path with an absolute host path.
PUID=1000
PGID=1000
MULI_INGEST_STATE=/absolute/path/to/muli-ingest/state
MULI_INGEST_STAGING=/absolute/path/to/muli-ingest/staging
MULI_INGEST_SOURCE=/absolute/path/to/camera-volume-01
MULI_INGEST_SOURCE_01_LABEL=Camera 01
MULI_INGEST_SOURCE_01_UUID=REPLACE-WITH-VOLUME-UUID-01
MULI_INGEST_SOURCE_02=/absolute/path/to/camera-volume-02
MULI_INGEST_SOURCE_02_LABEL=Camera 02
MULI_INGEST_SOURCE_02_UUID=REPLACE-WITH-VOLUME-UUID-02
MULI_INGEST_EXTERNAL_ROOT=/absolute/path/to/removable-mount-root
MULI_INGEST_ACCESS_CODE_FILE=/absolute/path/to/private/access-code
MULI_INGEST_BIND_ADDRESS=0.0.0.0
MULI_INGEST_ALLOWED_HOST=muli-ingest.local
MULI_INGEST_PORT=18765
